# Brevo (Sendinblue) — envio do formulário de contato via api/contact.js
# Copie para .env (Vercel: vercel env add) e preencha com os valores reais. Nunca commite o .env real.

# Chave de API da conta Brevo (Transactional > API keys)
BREVO_API_KEY=

# Remetente verificado na conta Brevo (Senders & IP > Senders)
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Site Jeiel IT Advisory

# Caixa que recebe as solicitações do formulário
CONTACT_TO_EMAIL=jeiel.borner+advisory@gmail.com
